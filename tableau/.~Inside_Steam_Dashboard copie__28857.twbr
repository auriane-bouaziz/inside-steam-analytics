    <dashboard enable-sort-zone-taborder='true' name='03 — Reach &amp; Decision Insights'>
      <style />
      <size maxheight='720' maxwidth='1280' minheight='720' minwidth='1280' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97778' id='12' param='horz' type-v2='layout-flow' w='98750' x='625' y='1111'>
            <zone h='97778' id='3' param='vert' type-v2='layout-flow' w='98750' x='625' y='1111'>
              <zone fixed-size='37' h='6250' id='33' is-fixed='true' type-v2='empty' w='98750' x='625' y='1111'>
