                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone fixed-size='259' h='35139' id='14' is-fixed='true' name='ML — Feature Importance' w='98750' x='625' y='40555'>
                <layout-cache minwidth='200' type-h='cell' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='22' h='4167' id='35' is-fixed='true' type-v2='empty' w='98750' x='625' y='75694'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='90' forceUpdate='true' h='13611' id='15' is-fixed='true' type-v2='text' w='98750' x='625' y='79861'>
                <formatted-text>
                  <run>KEY TAKEAWAY&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>Random Forest performed better overall than Logistic Regression.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>Product characteristics contain useful predictive signal, but precision remains limited.</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontsize='11'>Price was the most informative feature, but feature importance does not imply causality.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#c0c0c0' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='1' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='31' forceUpdate='true' h='5417' id='16' is-fixed='true' type-v2='text' w='98750' x='625' y='93472'>
                <formatted-text>
                  <run fontcolor='#555555'>High reach = at least 100,000 estimated owners. The model uses product-positioning features only; performance variables were excluded to reduce leakage.</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
          <zone-style>
