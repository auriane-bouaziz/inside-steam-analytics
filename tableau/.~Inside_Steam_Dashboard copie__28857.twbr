              <calculation class='tableau' formula='IF [reach_status] = &quot;High Reach (100k+)&quot; THEN 1&#10;ELSEIF [reach_status] = &quot;Below 100k&quot; THEN 0&#10;END' />
            </column>
            <column caption='Has DLC Numeric' datatype='integer' default-format='p0.0%' name='[Calculation_0553520247283714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [dlc_count] &gt; 0 THEN 1&#10;ELSE 0&#10;END' />
            </column>
            <column caption='Platform Count' datatype='integer' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0553520250384387]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(IF [windows] THEN 1 ELSE 0 END)&#10;+&#10;(IF [mac] THEN 1 ELSE 0 END)&#10;+&#10;(IF [linux] THEN 1 ELSE 0 END)' />
            </column>
            <column caption='Satisfaction 50+ Reviews' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[Calculation_1184502562959360]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [num_reviews_total] &gt;= 50 THEN [pct_pos_total]&#10;END' />
