                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone fixed-size='127' h='17639' id='6' is-fixed='true' param='horz' type-v2='layout-flow' w='98750' x='625' y='22916'>
                <zone h='17639' id='7' name='ML — ROC AUC' w='49375' x='625' y='22916'>
                  <layout-cache fixed-size-h='113' minwidth='220' type-h='fixed' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
