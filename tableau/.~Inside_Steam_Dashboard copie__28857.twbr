              </zone>
              <zone fixed-size='72' forceUpdate='true' h='11111' id='5' is-fixed='true' type-v2='text' w='98750' x='625' y='7361'>
                <formatted-text>
                  <run fontalignment='1' fontcolor='#1b2838' fontsize='20'>INSIDE STEAM — REACH &amp; DECISION INSIGHTS</run>
                  <run fontalignment='1'>Æ&#10;</run>
                  <run fontalignment='1' fontcolor='#797979' fontsize='14'>Testing whether product characteristics can help identify high-reach games</run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
